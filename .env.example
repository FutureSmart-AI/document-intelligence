# Fresh independent installation: deploy/configure.py generates secrets.
# Container environment takes precedence over ENV_FILE; no tracked real .env files.
MODE=STANDALONE
AUTH_MODE=standalone
FASTAPI_SECRET_KEY=replace-with-random-signing-secret
# Retain the previous pepper when rotating an existing master key; empty uses the master.
API_KEY_HASH_SECRET=
STANDALONE_OWNER_EMAIL=owner@example.test
STANDALONE_PASSWORD=replace-with-random-workspace-password
SESSION_HTTPS_ONLY=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=di
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB_NAME=di_standalone
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
BUCKET_NAME=di-documents
SQS_AWS_REGION=us-east-1
SQS_AWS_ACCESS_KEY_ID=test
SQS_AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=di-ingestion.fifo
SQS_QUEUE_URL=http://localstack:4566/000000000000/di-ingestion.fifo
CELERY_BROKER_URL=sqs://test:test@localstack:4566
CELERY_RESULT_BACKEND=redis://redis:6379/0
KNOWLEDGE_API_BASE_URL=http://api:8000/api/knowledge
KNOWLEDGE_API_KEY=replace-with-the-same-FASTAPI_SECRET_KEY
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional: Anthropic models chosen per collection or the extraction-validation judge.
ANTHROPIC_API_KEY=
# Written by deploy/configure.py from deploy/model-profiles.json (openai-v1 shown;
# the profile's "operations" map documents each one). Code defaults match these.
MODEL_PROFILE=openai-v1
ENRICHMENT_MODEL=gpt-5.4-mini
ENRICHMENT_FALLBACK_MODEL=gpt-5.4-nano
RAG_CHAT_REFINED_QUERY_LLM_PROVIDER=openai
RAG_CHAT_REFINED_QUERY_LLM_MODEL=gpt-5.4-nano
RAG_CHAT_AGENT_LLM_PROVIDER=openai
RAG_CHAT_AGENT_LLM_MODEL=gpt-5.6-luna
RAG_FALLBACK_PROVIDER=openai
RAG_FALLBACK_MODEL=gpt-5.4-mini
RAG_RETRIEVAL_VERIFIER_PROVIDER=openai
RAG_RETRIEVAL_VERIFIER_MODEL=gpt-5.4-nano
# Applies while a collection has no chat-config row; see docs/configuration.md.
RAG_CHAT_ANSWER_LLM_PROVIDER=openai
RAG_CHAT_ANSWER_LLM_MODEL=gpt-5.6-luna
FOLLOW_UP_LLM_PROVIDER=openai
FOLLOW_UP_LLM_MODEL=gpt-5.4-nano
CHART_EXTRACTION_MODEL=gpt-5.4-mini
# Chart type/column choice for the in-process renderer (used when CHART_API_URL is empty).
CHART_RENDER_PROVIDER=openai
CHART_RENDER_MODEL=gpt-5.4-mini
TRANSCRIPT_PROVIDER=openai
EXTRACTION_VALIDATION_LLM_ENABLED=false
LLAMA_PARSE_API_KEY=
FIRECRAWL_API_KEY=
USAGE_CREDENTIALS_MASTER_KEY=replace-with-Fernet-key
USAGE_CREDENTIALS_HASH_SALT=replace-with-random-salt
BYOK_PLATFORM_FALLBACK=false
# Optional hosted Chart API (empty: charts are drawn in-process) and tracing.
CHART_API_URL=
CHART_SERVICE_KEY=
OTEL_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
CONNECTOR_RUNNER_INPROCESS=false
REPORTS_SCHEDULER_ENABLED=false
COST_SWEEPER_ENABLED=false
CHAT_COST_FINALIZE_ENABLED=false

# Generated privately by deploy/configure.py for optional connector credentials.
CONNECTOR_SECRET_KEY=
