# Fresh independent installation: deploy/configure.py generates secrets.
# Container environment takes precedence over ENV_FILE; no tracked real .env files.
MODE=STANDALONE
AUTH_MODE=standalone
FASTAPI_SECRET_KEY=replace-with-random-signing-secret
STANDALONE_OWNER_EMAIL=owner@example.test
STANDALONE_PASSWORD=replace-with-random-workspace-password
SESSION_HTTPS_ONLY=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=di
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB_NAME=di_standalone
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
BUCKET_NAME=di-documents
SQS_AWS_REGION=us-east-1
SQS_AWS_ACCESS_KEY_ID=test
SQS_AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=di-ingestion.fifo
SQS_QUEUE_URL=http://localstack:4566/000000000000/di-ingestion.fifo
CELERY_BROKER_URL=sqs://test:test@localstack:4566
CELERY_RESULT_BACKEND=redis://redis:6379/0
KNOWLEDGE_API_BASE_URL=http://api:8000/api/knowledge
KNOWLEDGE_API_KEY=replace-with-the-same-FASTAPI_SECRET_KEY
OPENAI_API_KEY=
GROQ_API_KEY=
# Existing deployed follow-up model configuration.
FOLLOW_UP_LLM_PROVIDER=openai
FOLLOW_UP_LLM_MODEL=gpt-5.4-nano
LLAMA_PARSE_API_KEY=
FIRECRAWL_API_KEY=
USAGE_CREDENTIALS_MASTER_KEY=replace-with-Fernet-key
USAGE_CREDENTIALS_HASH_SALT=replace-with-random-salt
BYOK_PLATFORM_FALLBACK=false
# Optional configured integrations; empty disables private chart and trace calls.
CHART_API_URL=
OTEL_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
CONNECTOR_RUNNER_INPROCESS=false
REPORTS_SCHEDULER_ENABLED=false
COST_SWEEPER_ENABLED=false
CHAT_COST_FINALIZE_ENABLED=false
